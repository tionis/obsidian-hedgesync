{
  "name": "obsidian-hedgesync",
  "version": "0.1.7",
  "description": "Obsidian plugin to sync notes with HedgeDoc using frontmatter links and hedgesync",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "release:version": "node scripts/release-version.mjs",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@eslint/json": "^0.14.0",
    "@types/node": "^16.11.6",
    "esbuild": "0.25.5",
    "eslint": "9.30.1",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "14.0.0",
    "jiti": "2.6.1",
    "tslib": "2.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.35.1"
  },
  "dependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "hedgesync": "^2.0.0",
    "obsidian": "latest"
  }
}
